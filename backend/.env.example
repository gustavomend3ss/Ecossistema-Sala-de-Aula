# Copie para .env e ajuste. O arquivo .env NÃO vai para o repositório.

# PostgreSQL (docker compose up -d db). Sem esta linha, usa SQLite local.
DATABASE_URL=postgresql+psycopg://ecossistema:ecossistema@localhost:5432/ecossistema

# Síntese auxiliar com Gemini (opcional). Sem chave, o sistema funciona normalmente.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Origens liberadas para o Flutter Web (separe por vírgula). * = qualquer uma (só em desenvolvimento).
CORS_ORIGINS=*
