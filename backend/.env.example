# Copie para .env e ajuste. O arquivo .env NÃO vai para o repositório.

# PostgreSQL (docker compose up -d db). Sem esta linha, usa SQLite local.
DATABASE_URL=postgresql+psycopg://ecossistema:ecossistema@localhost:5432/ecossistema

# Chave que assina os tokens de acesso. Troque por um texto aleatório longo.
SECRET_KEY=troque-esta-chave

# Gemini (opcional): interpreta perguntas do assistente e redige as respostas.
# Sem chave, o assistente funciona só com as regras e o RapidFuzz.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TIMEOUT=15

# Limiares do RapidFuzz (0 a 100) para reconhecer disciplinas e estudantes.
# Acima de ACEITE: usa direto. Entre SUGESTAO e ACEITE: pergunta "você quis dizer...?".
# Dois candidatos a menos de MARGEM pontos um do outro: pede para escolher.
FUZZY_ACEITE=85
FUZZY_SUGESTAO=70
FUZZY_MARGEM=4

# Origens liberadas para o Flutter Web em desenvolvimento (* = qualquer uma).
CORS_ORIGINS=*

# Fixa a data dos prazos (AAAA-MM-DD). Vazio = data de hoje.
DATA_REFERENCIA=
