{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "web": {
      "root": "app",
      "installCommand": "git clone --depth 1 --filter=blob:none --sparse -b stable https://github.com/flutter/flutter.git /tmp/flutter && git -C /tmp/flutter sparse-checkout set bin packages && /tmp/flutter/bin/flutter config --enable-web --no-analytics",
      "buildCommand": "/tmp/flutter/bin/flutter create . --project-name ecossistema_academico --org br.edu.fainor --platforms=web && /tmp/flutter/bin/flutter pub get && /tmp/flutter/bin/flutter build web --release --no-web-resources-cdn",
      "outputDirectory": "build/web"
    },
    "api": {
      "root": "backend",
      "framework": "fastapi",
      "entrypoint": "app.main:app",
      "routes": [
        {
          "src": "/api/(.*)",
          "transforms": [
            {
              "type": "request.path",
              "op": "set",
              "args": "/$1"
            }
          ]
        }
      ]
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "api"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "web"
      }
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains"
        }
      ]
    }
  ],
  "git": {
    "deploymentEnabled": {
      "ci-output": false
    }
  }
}
